{
  "name": "cj-klinik-website",
  "private": true,
  "version": "1.0.0",
  "description": "CJ Klinik public website + staff system, deployed on Cloudflare Pages with a D1 database.",
  "scripts": {
    "dev": "wrangler pages dev . --d1=DB --compatibility-date=2024-09-23",
    "db:migrate:local": "wrangler d1 execute cj-klinik-db --local --file=./db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute cj-klinik-db --remote --file=./db/schema.sql",
    "deploy": "wrangler pages deploy ."
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
